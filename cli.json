{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "agent.cycle": "tab",
    "agent.cycle.reverse": "shift+tab"
  },
  "theme": {
    "name": "claude",
    "mode": "system"
  },
  "cursor": {
    "style": "block",
    "blinking": false
  },
  "mouse": true,
  "scroll": {
    "acceleration": true
  },
  "prompt": {
    "image_preview": true
  },
  "attention": {
    "notifications": true,
    "sound": true
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "image_preview": true,
    "permissions": "autoaccept"
  },
  "animations": true,
  "tabs": {
    "enabled": false
  }
}
