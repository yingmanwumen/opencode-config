{
  "$schema": "https://opencode.ai/config.json",
  "snapshots": false,
  "mcp": {},
  "plugins": [],
  "shell": "/bin/zsh",
  "lsp": false,
  "formatter": false,
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "deny" },
    { "action": "glob", "resource": "*", "effect": "deny" },
    { "action": "grep", "resource": "*", "effect": "deny" }
  ],
  "websearch": {
    "provider": "random"
  }
}
